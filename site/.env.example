# Sanity — the CMS behind the shop. Copy this file to .env.local and fill in
# the project id from https://sanity.io/manage (Project → Settings → API).
#
# With NEXT_PUBLIC_SANITY_PROJECT_ID unset the site still builds and runs: it
# falls back to the checked-in catalogue in lib/products.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
